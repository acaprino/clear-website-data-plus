# Mozilla Add-ons (AMO) API credentials for `web-ext sign`.
# Get them from: https://addons.mozilla.org/developers/addon/api/key/
#
# Copy this file to .env and fill in the values. .env is gitignored.
# `web-ext` reads these env vars directly — no need to source anywhere else.
#
# These are PERSONAL credentials. Never commit, never paste in chat, never log.

WEB_EXT_API_KEY=user:XXXXXXXX:NN
WEB_EXT_API_SECRET=YOUR_64_HEX_CHAR_SECRET
